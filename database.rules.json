{
  "rules": {
    "records": { ".read": true, ".write": false },
    "tokens":  { ".read": true, ".write": false },
    "config":  { ".read": true, ".write": false },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "classroomCodes": {
      "$code": {
        ".read": true,
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    "teachers": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "config": {
          ".read": true
        },

        "tokens": {
          ".read": true,
          "$student": {
            ".write": "$student.matches(/^[0-9]+$/)",
            ".validate": "(auth != null && auth.uid === $uid) || (newData.isNumber() && newData.val() >= 0)"
          }
        },

        "records": {
          ".read": true,
          "$recordId": {
            ".write": "(!data.exists() && newData.child('type').val() === 'completion') || (!newData.exists() && data.child('type').val() === 'completion')",
            ".validate": "(auth != null && auth.uid === $uid) || newData.hasChildren(['type', 'task_id', 'assigned_to'])"
          }
        }
      }
    }
  }
}
