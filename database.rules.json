{
  "rules": {
    "versus": {
      "$code": {
        ".read": true,
        ".write": "$code.matches(/^[a-l][a-l]$/) && (!data.exists() || !newData.exists() || data.child('t').val() < now - 900000 || newData.child('c').val() === data.child('c').val())",
        ".validate": "newData.hasChildren(['c', 't', 'q', 's', 'mx', 'st', 'rd', 'wn', 'p1'])",
        "c":  { ".validate": "newData.isNumber() && newData.val() <= now" },
        "t":  { ".validate": "newData.isNumber() && newData.val() <= now && (!data.exists() || newData.val() >= data.val())" },
        "q":  { ".validate": "newData.isString() && (newData.val() === 'x' || newData.val() === 'm')" },
        "s":  { ".validate": "newData.isString() && (newData.val() === 'own' || newData.val() === 'race')" },
        "mx": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 20 && newData.val() % 1 === 0" },
        "st": { ".validate": "newData.isString() && (newData.val() === 'wait' || newData.val() === 'play' || newData.val() === 'end')" },
        "rd": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0" },
        "wn": { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2)" },
        "p1": {
          ".validate": "newData.hasChildren(['n', 'av', 'w', 'hp', 'on', 'rm'])",
          "n":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "av": {
            "$g": { ".validate": "$g.matches(/^(skin|armor|tabard|cloak|head|hair|haircol|shield|sword|eyes|ears|beard|lash|neck|brace|pet)$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 199 && newData.val() % 1 === 0" }
          },
          "w":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999 && newData.val() % 1 === 0" },
          "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().parent().child('mx').val() && newData.val() % 1 === 0" },
          "on": { ".validate": "newData.isBoolean()" },
          "rm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0" },
          "$other": { ".validate": false }
        },
        "p2": {
          ".validate": "newData.hasChildren(['n', 'av', 'w', 'hp', 'on', 'rm'])",
          "n":  { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16" },
          "av": {
            "$g": { ".validate": "$g.matches(/^(skin|armor|tabard|cloak|head|hair|haircol|shield|sword|eyes|ears|beard|lash|neck|brace|pet)$/) && newData.isNumber() && newData.val() >= 0 && newData.val() <= 199 && newData.val() % 1 === 0" }
          },
          "w":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 99999 && newData.val() % 1 === 0" },
          "hp": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= newData.parent().parent().child('mx').val() && newData.val() % 1 === 0" },
          "on": { ".validate": "newData.isBoolean()" },
          "rm": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 999 && newData.val() % 1 === 0" },
          "$other": { ".validate": false }
        },
        "r": {
          ".validate": "newData.hasChildren(['k', 'a', 'b', 'm', 'w'])",
          "k":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 9999 && newData.val() % 1 === 0" },
          "a":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12 && newData.val() % 1 === 0" },
          "b":  { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 12 && newData.val() % 1 === 0" },
          "m":  { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2)" },
          "w":  { ".validate": "newData.isNumber() && (newData.val() === 0 || newData.val() === 1 || newData.val() === 2)" },
          "x1": { ".validate": "newData.isBoolean()" },
          "x2": { ".validate": "newData.isBoolean()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    },

    "records": { ".read": true, ".write": false },
    "tokens":  { ".read": true, ".write": false },
    "config":  { ".read": true, ".write": false },

    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": false
      }
    },

    "classroomCodes": {
      "$code": {
        ".read": true,
        ".write": "auth != null && !data.exists()",
        ".validate": "newData.isString() && newData.val() === auth.uid"
      }
    },

    "teachers": {
      "$uid": {
        ".read":  "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",

        "config": {
          ".read": true
        },

        "tokens": {
          ".read": true,
          "$student": {
            ".write": "$student.matches(/^[0-9]+$/)",
            ".validate": "(auth != null && auth.uid === $uid) || (newData.isNumber() && newData.val() >= 0)"
          }
        },

        "records": {
          ".read": true,
          "$recordId": {
            ".write": "(!data.exists() && newData.child('type').val() === 'completion') || (!newData.exists() && data.child('type').val() === 'completion')",
            ".validate": "(auth != null && auth.uid === $uid) || newData.hasChildren(['type', 'task_id', 'assigned_to'])"
          }
        }
      }
    }
  }
}
